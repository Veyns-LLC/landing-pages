# --- Loops.so (server-side only — never prefix these with VITE_) ---

# Loops dashboard -> Settings -> API -> create an API key.
# Consumed by the /api/subscribe serverless function.
LOOPS_API_KEY=

# Optional. Loops dashboard -> Audience -> Lists -> copy the list id.
# When set, new contacts are added to this mailing list.
LOOPS_MAILING_LIST_ID=

# Optional. Overrides the affiliate programme's Loops list id, which is
# otherwise defaulted in api/_loops.ts so a missing variable cannot silently
# drop affiliate signups off the list.
LOOPS_AFFILIATE_LIST_ID=
